<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Vael Paper server, as a macOS launchd agent.

  This is a TEMPLATE. launchd requires absolute paths and does not expand ~ or
  $HOME, so the four __VAEL_PAPER__ and __UV__ placeholders below must be
  substituted before the file will load. From the repository root:

      sed -e "s|__VAEL_PAPER__|$PWD|g" \
          -e "s|__UV__|$(command -v uv)|g" \
          launchd/com.coreautomation.vaelpaper.plist \
          > ~/Library/LaunchAgents/com.coreautomation.vaelpaper.plist

      mkdir -p data/logs
      launchctl load ~/Library/LaunchAgents/com.coreautomation.vaelpaper.plist

  To stop it:

      launchctl unload ~/Library/LaunchAgents/com.coreautomation.vaelpaper.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.coreautomation.vaelpaper</string>

  <key>ProgramArguments</key>
  <array>
    <string>__UV__</string>
    <string>run</string>
    <string>vael-paper</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__VAEL_PAPER__/server</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>VAEL_PAPER_PORT</key>
    <string>8791</string>
    <key>VAEL_PAPER_EDITIONS</key>
    <string>__VAEL_PAPER__/editions</string>
    <key>VAEL_PAPER_READER</key>
    <string>__VAEL_PAPER__/reader/dist</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>__VAEL_PAPER__/data/logs/vael-paper.log</string>
  <key>StandardErrorPath</key>
  <string>__VAEL_PAPER__/data/logs/vael-paper.err.log</string>
</dict>
</plist>
